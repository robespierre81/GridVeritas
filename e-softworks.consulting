# WebSocket upgrade for Grafana live (must live in http {}, not server {}).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name e-softworks.consulting www.e-softworks.consulting;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name e-softworks.consulting www.e-softworks.consulting;

    ssl_certificate /etc/letsencrypt/live/e-softworks.consulting/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/e-softworks.consulting/privkey.pem;

    # =============================================
    # 1. Cheetah API → Backend (Port 31987)
    # =============================================
    location /cheetah-api {
        proxy_pass http://127.0.0.1:31987;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;

        # Minimal headers - no complex if statements
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' '*' always;
    }

    # =============================================
    # 2. Cheetah Frontend → Frontend (Port 31989)
    # =============================================
    location /cheetah {
        proxy_pass http://127.0.0.1:31989/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =============================================
    # 3. Andere Apps (bestehende)
    # =============================================
    location / {
        proxy_pass http://127.0.0.1:31984/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Scheme https;
        proxy_redirect off;
    }

    location /erp {
        proxy_pass http://127.0.0.1:31985/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Scheme https;
        proxy_redirect off;
    }

    location /diva {
        proxy_pass http://127.0.0.1:31983/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Scheme https;
        proxy_redirect off;
    }

#    location /dailyaiwizard/ {
#        proxy_pass http://localhost:31980/;
#        proxy_set_header Host $host;
#        proxy_set_header X-Real-IP $remote_addr;
#        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#        proxy_set_header X-Forwarded-Proto $scheme;
                
#	proxy_buffering off;
#        proxy_redirect off;
#    }

#    location /dailyaiwizard/api {
#        proxy_pass http://127.0.0.1:31979/;
#        proxy_set_header Host $host;
#        proxy_set_header X-Real-IP $remote_addr;
#        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#        proxy_set_header X-Forwarded-Proto $scheme;
#	proxy_set_header X-Forwarded-Host $host;
#        proxy_set_header X-Forwarded-Prefix /dailyaiwizard;
#        proxy_buffering off;
#        proxy_redirect off;
#	proxy_read_timeout 300s;
#        proxy_send_timeout 300s;
#        proxy_http_version 1.1;
#    }

#    location /dailyaiwizard/chat {
#        proxy_pass http://127.0.0.1:31991/chat;
#        proxy_set_header Host $host;
#        proxy_set_header X-Real-IP $remote_addr;
#        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#        proxy_set_header X-Forwarded-Proto $scheme;

#        proxy_http_version 1.1;
#        proxy_buffering off;
#        proxy_redirect off;
#        proxy_read_timeout 300s;
#        proxy_send_timeout 300s;
#    }

    # Grafana serves from this subpath (GF_SERVER_SERVE_FROM_SUB_PATH=true).
    # Do not strip the URI — Grafana must see /gridveritas/grafana/...
    location = /gridveritas/grafana {
        return 301 /gridveritas/grafana/;
    }

    location /gridveritas/grafana/ {
        proxy_pass http://127.0.0.1:33000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    # Prometheus lives at / on :19090. Strip the prefix and rewrite
    # /graph (and other UI paths) back under this path.
    # Also set on the container:
    #   --web.external-url=https://e-softworks.consulting/gridveritas/prometheus/
    #   --web.route-prefix=/
    location = /gridveritas/prometheus {
        return 301 /gridveritas/prometheus/;
    }

    location /gridveritas/prometheus/ {
        proxy_pass http://127.0.0.1:19090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect / /gridveritas/prometheus/;
    }

    location /gridveritas {
        proxy_pass http://127.0.0.1:3080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /gridveritas;
        proxy_buffering off;
        proxy_redirect off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_http_version 1.1;
    }

    location /gridveritas/api/ {
        proxy_pass http://127.0.0.1:18080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /reacher {
        return 301 /reacher/;
    }

    # Trailing slashes must match. `location /reacher` + `proxy_pass ...:31990/`
    # produced `//api/auth/login`, which the UI nginx does not treat as /api/ (403).
    location /reacher/ {
        proxy_pass http://127.0.0.1:31990/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Scheme https;
        proxy_redirect off;
    }

    location = /jobhunter {
        return 301 /jobhunter/;
    }

    location /jobhunter/ {
        proxy_pass http://127.0.0.1:31992/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Scheme https;
        proxy_set_header X-Forwarded-Prefix /jobhunter;
        proxy_redirect off;
        client_max_body_size 10M;
        proxy_connect_timeout 15s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }     
}
